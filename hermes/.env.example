# Unified application bootstrap
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=1601
APP_WORKERS=1
APP_VERSION=0.3.0

# Security: use a comma-separated allow-list in production; never store keys here.
CORS_ORIGINS=http://localhost:1601,http://127.0.0.1:1601
CORS_ALLOW_CREDENTIALS=true
DOCS_ENABLED=true
MCP_ENABLED=true
# Production database. DATABASE_URL takes precedence; MYSQL_* is easier to maintain locally.
# DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/reactor_agent?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
UI_ENABLED=true
SCHEDULER_ENABLED=true
SESSION_SECRET=replace-with-a-random-secret
ADMIN_API_KEY=replace-with-a-long-random-api-key
# CHAT_MODEL=openai/gpt-4.1-mini

# Workspace storage
KNOWLEDGE_STORAGE_PATH=data/knowledge
IMAGE_STORAGE_PATH=data/images
DATASET_STORAGE_PATH=data/datasets

# Enterprise hybrid retrieval: BM25 + dense embeddings + weighted RRF.
# The embedding endpoint must be OpenAI-compatible. Do not commit real keys.
KNOWLEDGE_HYBRID_ENABLED=true
KNOWLEDGE_HYBRID_REQUIRED=true
TEXT_EMBEDDING_TYPE=openai
TEXT_EMBEDDING_MODEL_NAME=your-embedding-model
TEXT_EMBEDDING_BASE_URL=https://your-provider.example.com/v1
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_DIMENSION=1024
TEXT_EMBEDDING_MAX_TEXT_LENGTH=8000
# Development: persistent local Qdrant mode. Production should replace this line
# with KNOWLEDGE_QDRANT_URL plus QDRANT_API_KEY.
KNOWLEDGE_QDRANT_PATH=data/qdrant
# KNOWLEDGE_QDRANT_URL=https://your-qdrant.example.com:6333
QDRANT_API_KEY=
KNOWLEDGE_QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT=30
KNOWLEDGE_QDRANT_COLLECTION=hermes_knowledge_chunks_v1
HYBRID_DENSE_WEIGHT=0.65
HYBRID_LEXICAL_WEIGHT=0.35
# Calibrate on your own negative-query set; 0.38 is the demo model baseline.
HYBRID_DENSE_MIN_SCORE=0.38

# Observability
LOG_LEVEL=INFO
LOG_PATH=logs/server.log
LOG_FILE_ENABLED=true
LOG_REQUEST_BODIES=false

# Tool artifact service
FILE_SAVE_PATH=skilloutput
FILE_SERVER_URL=http://127.0.0.1:1601/v1/file_tool
